; Thunk prelude. Everything here is written in the language and is
; loaded on every node before any program.

; (fold f init xs) applies f to an accumulator and each element in turn.
; It is the sequential building block; nothing here is parallel.
(def fold (lambda (f init xs)
  (if (nil? xs)
    init
    (fold f (f init (head xs)) (tail xs)))))

(def length (lambda (xs)
  (fold (lambda (acc x) (add acc 1)) 0 xs)))

(def reverse (lambda (xs)
  (fold (lambda (acc x) (cons x acc)) () xs)))

(def append (lambda (xs ys)
  (fold (lambda (acc x) (cons x acc)) ys (reverse xs))))

(def map (lambda (f xs)
  (reverse (fold (lambda (acc x) (cons (f x) acc)) () xs))))

(def filter (lambda (p xs)
  (reverse (fold (lambda (acc x) (if (p x) (cons x acc) acc)) () xs))))

; take-rev collects the first n elements in reverse order, so that take
; runs in constant stack and reverses once at the end.
(def take-rev (lambda (n xs acc)
  (if (eq n 0)
    acc
    (if (nil? xs)
      acc
      (take-rev (sub n 1) (tail xs) (cons (head xs) acc))))))

(def take (lambda (n xs)
  (reverse (take-rev n xs ()))))

(def drop (lambda (n xs)
  (if (eq n 0)
    xs
    (if (nil? xs)
      ()
      (drop (sub n 1) (tail xs))))))

(def split-at (lambda (n xs)
  (cons (take n xs) (cons (drop n xs) ()))))

(def halves (lambda (xs)
  (split-at (div (length xs) 2) xs)))

; Parallel library. dc is the only source of parallelism; pmap and
; reduce are ordinary definitions on top of it. small? decides when a
; list is solved directly and must be true for any list of length one.

(def pmap (lambda (f xs small?)
  (dc xs small? halves (lambda (v) (map f v)) append)))

; reduce requires op to be associative. It is undefined on the empty list.
(def reduce (lambda (op xs small?)
  (dc xs small? halves (lambda (v) (fold op (head v) (tail v))) op)))

; Sorting.

(def insert (lambda (x sorted)
  (if (nil? sorted)
    (cons x ())
    (if (lt x (head sorted))
      (cons x sorted)
      (cons (head sorted) (insert x (tail sorted)))))))

(def insertion-sort (lambda (xs)
  (fold (lambda (acc x) (insert x acc)) () xs)))

; merge-rev builds the merged list in reverse, in constant stack. When
; the elements are equal the left one goes first, so the sort is stable.
(def merge-rev (lambda (xs ys acc)
  (if (nil? xs)
    (append (reverse ys) acc)
    (if (nil? ys)
      (append (reverse xs) acc)
      (if (lt (head ys) (head xs))
        (merge-rev xs (tail ys) (cons (head ys) acc))
        (merge-rev (tail xs) ys (cons (head xs) acc)))))))

(def merge-sorted (lambda (xs ys)
  (reverse (merge-rev xs ys ()))))

(def mergesort (lambda (xs small?)
  (dc xs small? halves insertion-sort merge-sorted)))

; Strings. Text arrives as a list of codepoints (see the chars primitive);
; words are turned back into strings so they compare cheaply.

(def whitespace? (lambda (c)
  (if (eq c 32) true (if (eq c 10) true (if (eq c 9) true (eq c 13))))))

; flush adds the pending word (kept in reverse) to the accumulator.
(def flush (lambda (word acc)
  (if (nil? word) acc (cons (string (reverse word)) acc))))

(def split-words-rev (lambda (cs word acc)
  (if (nil? cs)
    (flush word acc)
    (if (whitespace? (head cs))
      (split-words-rev (tail cs) () (flush word acc))
      (split-words-rev (tail cs) (cons (head cs) word) acc)))))

(def split-words (lambda (cs)
  (reverse (split-words-rev cs () ()))))

; Association lists of (key value) pairs. A deliberately simple
; dictionary; a balanced tree can replace it if measurements say so.

(def assoc-get (lambda (k al default)
  (if (nil? al)
    default
    (if (eq (head (head al)) k)
      (head (tail (head al)))
      (assoc-get k (tail al) default)))))

(def assoc-inc (lambda (k n al)
  (if (nil? al)
    (cons (cons k (cons n ())) ())
    (if (eq (head (head al)) k)
      (cons (cons k (cons (add n (head (tail (head al)))) ())) (tail al))
      (cons (head al) (assoc-inc k n (tail al)))))))

(def assoc-merge (lambda (a b)
  (fold (lambda (acc entry) (assoc-inc (head entry) (head (tail entry)) acc)) a b)))

(def count-words (lambda (words)
  (fold (lambda (acc w) (assoc-inc w 1 acc)) () words)))

; Word count demo. Tokenizing is sequential here; only the counting is
; divided. Splitting the text itself in parallel is a later refinement.
(def word-count (lambda (text small?)
  (dc (split-words (chars text)) small? halves count-words assoc-merge)))

; Integers and ranges.

(def max (lambda (a b) (if (lt a b) b a)))

(def min (lambda (a b) (if (lt a b) a b)))

; (range from to) is the list from, from+1, ..., to-1.
(def range-rev (lambda (i to acc)
  (if (lt i to) (range-rev (add i 1) to (cons i acc)) acc)))

(def range (lambda (from to)
  (reverse (range-rev from to ()))))

; Integer square root by Newton's method, starting from n and going
; down until the estimate stops decreasing.
(def isqrt-iter (lambda (n x)
  (let y (div (add x (div n x)) 2)
    (if (lt y x) (isqrt-iter n y) x))))

(def isqrt (lambda (n)
  (if (lt n 2) n (isqrt-iter n n))))
